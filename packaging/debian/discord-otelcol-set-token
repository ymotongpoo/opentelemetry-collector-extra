#!/usr/bin/python3
# Copyright 2026 Yoshi Yamaguchi
# SPDX-License-Identifier: Apache-2.0
"""Register a Discord token without writing plaintext to disk."""

import argparse
import getpass
import os
from pathlib import Path
import re
import resource
import stat
import subprocess
import sys
import tempfile


CREDENTIAL = Path('/etc/credstore.encrypted/discord-otelcol.token')
CREDENTIAL_NAME = 'discord_bot_token'
CONFIG = Path('/etc/discord-otelcol/config.yaml')
LEGACY = Path('/etc/discord-otelcol/environment')
REFERENCE = '${file:${env:CREDENTIALS_DIRECTORY}/discord_bot_token}'


def valid_token(value):
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,4096}', value):
        raise ValueError('token must be non-empty ASCII without whitespace')
    return value.encode('ascii')


def atomic_write(path, data, mode):
    fd, name = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
            os.fchmod(output.fileno(), mode)
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)


def decrypt(path):
    return subprocess.run(
        ['systemd-creds', 'decrypt', '--name=' + CREDENTIAL_NAME, str(path), '-'],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    ).stdout


def encrypt(token, key):
    CREDENTIAL.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.discord-otelcol.', dir=CREDENTIAL.parent)
    os.close(fd)
    temporary = Path(name)
    try:
        subprocess.run(
            ['systemd-creds', 'encrypt', '--with-key=' + key,
             '--name=' + CREDENTIAL_NAME, '-', str(temporary)],
            input=token, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        # Verify decryption before replacing a working credential or removing plaintext.
        if decrypt(temporary) != token:
            raise ValueError('credential verification failed')
        os.chmod(temporary, 0o600)
        os.replace(temporary, CREDENTIAL)
    finally:
        temporary.unlink(missing_ok=True)


def migrate(key):
    remaining = []
    token = None
    had_token = False
    if LEGACY.exists():
        for line in LEGACY.read_text().splitlines(keepends=True):
            match = re.match(r'^\s*DISCORD_BOT_TOKEN\s*=(.*)$', line)
            if not match:
                remaining.append(line)
                continue
            had_token = True
            value = match[1].strip()
            if len(value) >= 2 and value[0] in "\"'" and value[-1] == value[0]:
                value = value[1:-1]
            token = valid_token(value) if value else None
        if token:
            if CREDENTIAL.exists():
                # An explicitly configured encrypted credential takes precedence.
                valid_token(decrypt(CREDENTIAL).decode('ascii'))
            else:
                encrypt(token, key)
    if CONFIG.exists():
        before = CONFIG.read_text()
        after = before.replace('${env:DISCORD_BOT_TOKEN}', REFERENCE)
        if before != after:
            atomic_write(CONFIG, after.encode(), stat.S_IMODE(CONFIG.stat().st_mode))
    if LEGACY.exists() and had_token:
        if any(line.strip() and not line.lstrip().startswith('#') for line in remaining):
            atomic_write(LEGACY, ''.join(remaining).encode(), stat.S_IMODE(LEGACY.stat().st_mode))
        else:
            LEGACY.unlink()
    elif LEGACY.exists() and not any(
        line.strip() and not line.lstrip().startswith('#') for line in remaining
    ):
        LEGACY.unlink()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--with-key', choices=('auto', 'host', 'tpm2', 'host+tpm2'), default='auto')
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--stdin', action='store_true', help='read the token from a pipe')
    mode.add_argument('--migrate', action='store_true', help='migrate the legacy environment file')
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('run this command with sudo')
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    os.umask(0o077)
    try:
        if args.migrate:
            migrate(args.with_key)
            return 0
        if args.stdin:
            raw = sys.stdin.buffer.read(4098)
            if raw.endswith(b'\n'):
                raw = raw[:-1]
            token = valid_token(raw.decode('ascii'))
        else:
            if not sys.stdin.isatty():
                parser.error('use a terminal for hidden input, or pass --stdin')
            token = valid_token(getpass.getpass('Discord bot token (hidden): '))
        encrypt(token, args.with_key)
        migrate(args.with_key)
        print('Encrypted token saved. Restart discord-otelcol.service to apply it.')
        print('Requested key mode: ' + args.with_key + ' (auto uses available TPM/host protection).')
        return 0
    except (EOFError, KeyboardInterrupt):
        print('\nToken registration cancelled.', file=sys.stderr)
        return 130
    except subprocess.CalledProcessError:
        print('Credential encryption/decryption failed; existing plaintext was retained. '
              'Check systemd/TPM support or explicitly select --with-key=host.', file=sys.stderr)
    except (OSError, ValueError, UnicodeError):
        print('Token registration or legacy migration failed; check the input and file permissions.',
              file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
