[Unit]
Description=OpenTelemetry Collector Extra
Documentation=https://github.com/ymotongpoo/opentelemetry-collector-extra
Wants=network-online.target
After=network-online.target alloy.service

[Service]
Type=simple
DynamicUser=true
StateDirectory=otelcol-extra
WorkingDirectory=/var/lib/otelcol-extra
EnvironmentFile=-/etc/otelcol-extra/environment
ExecStart=/usr/lib/otelcol-extra/run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
# Go's net.Interfaces uses NETLINK_ROUTE to enumerate LAN addresses.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
