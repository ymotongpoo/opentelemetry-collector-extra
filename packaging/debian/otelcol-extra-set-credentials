#!/usr/bin/python3
# Copyright 2026 Yoshi Yamaguchi
# SPDX-License-Identifier: Apache-2.0
"""Register encrypted Collector credentials, or migrate the old Discord package."""

import argparse
import getpass
import json
import os
from pathlib import Path
import re
import resource
import shutil
import stat
import subprocess
import sys
import tempfile
import warnings

ETC = Path('/etc/otelcol-extra')
LEGACY = Path('/etc/discord-otelcol')
STORE = Path('/etc/credstore.encrypted')
DROPINS = Path('/etc/systemd/system/otelcol-extra.service.d')
DEFAULT = Path('/usr/share/otelcol-extra/config.default.yaml')
OLD_STATE = Path('/var/lib/discord-otelcol')
NEW_STATE = Path('/var/lib/otelcol-extra')
IDENTITIES = {'discord': 'discord_bot_token', 'switchbot': 'switchbot_cloud', 'slack': 'slack_receiver'}


def atomic_write(path, data, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
            os.fchmod(output.fileno(), mode)
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)


def credential_path(component):
    return STORE / ('otelcol-extra.' + component)


def decrypt(path, name):
    return subprocess.run(['systemd-creds', 'decrypt', '--name=' + name, str(path), '-'],
                          check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout


def install_dropin(component):
    DROPINS.mkdir(mode=0o755, parents=True, exist_ok=True)
    data = '[Service]\nLoadCredentialEncrypted=' + IDENTITIES[component] + ':' + str(credential_path(component)) + '\n'
    atomic_write(DROPINS / ('20-' + component + '-credentials.conf'), data.encode(), 0o644)


def encrypt(payload, component, key):
    STORE.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.otelcol-extra.', dir=STORE)
    os.close(fd)
    try:
        subprocess.run(['systemd-creds', 'encrypt', '--with-key=' + key,
                        '--name=' + IDENTITIES[component], '-', temporary], input=payload,
                       check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if decrypt(Path(temporary), IDENTITIES[component]) != payload:
            raise ValueError('credential verification failed')
        os.chmod(temporary, 0o600)
        os.replace(temporary, credential_path(component))
    finally:
        Path(temporary).unlink(missing_ok=True)
    install_dropin(component)


def valid(value):
    if not re.fullmatch(r'[\x21-\x7e]{1,4096}', value):
        raise ValueError('credentials must be non-empty printable ASCII without whitespace')
    return value


def migrate(key):
    """Keep the encrypted credential identity; file names are not its identity."""
    current = credential_path('discord')
    old_cipher = STORE / 'discord-otelcol.token'
    old_environment = LEGACY / 'environment'
    remaining = []
    token = None
    had_token = False
    if old_environment.exists():
        for line in old_environment.read_text().splitlines(keepends=True):
            match = re.match(r'^\s*DISCORD_BOT_TOKEN\s*=(.*)$', line)
            if not match:
                remaining.append(line)
                continue
            had_token = True
            value = match[1].strip()
            if len(value) >= 2 and value[0] in "\"'" and value[-1] == value[0]:
                value = value[1:-1]
            token = valid(value) if value else None
    if current.exists():
        valid(decrypt(current, IDENTITIES['discord']).decode('ascii'))
        install_dropin('discord')
    elif old_cipher.exists():
        valid(decrypt(old_cipher, IDENTITIES['discord']).decode('ascii'))
        atomic_write(current, old_cipher.read_bytes())
        install_dropin('discord')
    elif token:
        encrypt(token.encode('ascii'), 'discord', key)

    config = ETC / 'config.yaml'
    old_config = LEGACY / 'config.yaml'
    pristine = not config.exists() or (DEFAULT.exists() and config.read_bytes() == DEFAULT.read_bytes())
    if pristine and old_config.exists():
        content = old_config.read_text().replace('/etc/discord-otelcol/', '/etc/otelcol-extra/')
        content = content.replace('${env:DISCORD_BOT_TOKEN}', '${file:${env:CREDENTIALS_DIRECTORY}/discord_bot_token}')
        atomic_write(config, content.encode(), 0o644)
    elif config.exists() and current.exists():
        before = config.read_text()
        after = before.replace('${env:DISCORD_BOT_TOKEN}', '${file:${env:CREDENTIALS_DIRECTORY}/discord_bot_token}')
        if after != before:
            atomic_write(config, after.encode(), stat.S_IMODE(config.stat().st_mode))

    # Do not remove a usable plaintext assignment until encryption was verified.
    if had_token and token and not current.exists():
        raise ValueError('legacy credential was not migrated')
    if old_environment.exists():
        extra = ''.join(remaining).encode()
        if any(line.strip() and not line.lstrip().startswith('#') for line in remaining):
            if not (ETC / 'environment').exists():
                atomic_write(ETC / 'environment', extra)
            if had_token:
                atomic_write(old_environment, extra, stat.S_IMODE(old_environment.stat().st_mode))
        elif had_token:
            old_environment.unlink()

    # A package reinstall can recreate registered drop-ins without asking for keys.
    for component, identity in IDENTITIES.items():
        path = credential_path(component)
        if path.exists():
            decrypt(path, identity)
            install_dropin(component)
    if OLD_STATE.is_dir() and (not NEW_STATE.exists() or not any(NEW_STATE.iterdir())):
        # Preserve symlinks as links; never copy their privileged target contents.
        shutil.copytree(OLD_STATE, NEW_STATE, symlinks=True, dirs_exist_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('component', nargs='?', choices=tuple(IDENTITIES))
    parser.add_argument('--with-key', choices=('auto', 'host', 'tpm2', 'host+tpm2'), default='auto')
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--stdin', action='store_true', help='read one value per line')
    mode.add_argument('--migrate', action='store_true', help='migrate the old Discord installation')
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('run with sudo')
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    os.umask(0o077)
    try:
        if args.migrate:
            if args.component:
                parser.error('--migrate does not take a component')
            migrate(args.with_key)
            return 0
        if not args.component:
            parser.error('select discord, switchbot or slack')
        prompts = {'discord': ['Discord bot token'], 'switchbot': ['SwitchBot Token', 'SwitchBot Secret'],
                   'slack': ['Slack bot token', 'Slack app token']}[args.component]
        if args.stdin:
            raw = sys.stdin.buffer.read(8195)
            values = raw.decode('ascii').splitlines()
            if len(values) != len(prompts):
                raise ValueError('wrong number of input values')
            values = [valid(value) for value in values]
        else:
            if not sys.stdin.isatty():
                parser.error('use an interactive terminal, or --stdin')
            with warnings.catch_warnings():
                warnings.simplefilter('error', getpass.GetPassWarning)
                values = [valid(getpass.getpass(prompt + ' (hidden): ')) for prompt in prompts]
        if args.component == 'discord':
            payload = values[0].encode('ascii')
        else:
            keys = ['token', 'secret'] if args.component == 'switchbot' else ['bot_token', 'app_token']
            payload = json.dumps(dict(zip(keys, values))).encode('ascii')
        encrypt(payload, args.component, args.with_key)
        print('Encrypted credentials saved. Enable the matching configuration snippet, then run:')
        print('sudo systemctl daemon-reload')
        print('sudo systemctl restart otelcol-extra.service')
        return 0
    except (EOFError, KeyboardInterrupt):
        print('\nCancelled.', file=sys.stderr)
        return 130
    except (OSError, ValueError, UnicodeError, getpass.GetPassWarning, subprocess.CalledProcessError):
        print('Credential registration or migration failed; existing source data was retained. '
              'Check permissions and systemd/TPM support.', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
