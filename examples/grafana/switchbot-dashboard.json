    {
      "id": 10,
      "title": "電池残量（最新）",
      "type": "bargauge",
      "description": "APIから報告された電池残量。低い順に表示します。機種により粗い段階値です。未対応・欠測・期限切れの機器には値を補いません。",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 14
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort(max by (switchbot_device_id, switchbot_device_name, switchbot_device_type) (switchbot_battery_percent{switchbot_device_type=~\"${device_type}\",switchbot_device_id=~\"${device}\"}))",
          "editorMode": "code",
          "legendFormat": "{{switchbot_device_name}} [{{switchbot_device_id}}]",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "green",
                "value": 40
              }
            ]
          }
        },
