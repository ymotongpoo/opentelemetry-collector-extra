      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 20,
        "minVizWidth": 0,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "title": "デバイス別の観測状況",
      "type": "table",
      "description": "「観測値あり」は有効な測定値が1つ以上ある状態。「観測値なし」にはAPI未対応や取得失敗・期限切れを含みます。安定したIDで機器を区別します。",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 14
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (switchbot_device_id, switchbot_device_name, switchbot_device_type) (switchbot_device_available_ratio{switchbot_device_type=~\"${device_type}\",switchbot_device_id=~\"${device}\"})",
          "editorMode": "code",
          "legendFormat": "{{switchbot_device_name}} [{{switchbot_device_id}}]",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "switchbot_device_name": 0,
              "switchbot_device_type": 1,
              "Value": 2,
              "switchbot_device_id": 3
            },
            "renameByName": {
              "switchbot_device_name": "デバイス",
              "switchbot_device_type": "機種",
              "Value": "観測値",
