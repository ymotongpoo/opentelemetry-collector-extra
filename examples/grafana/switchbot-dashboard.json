    {
      "id": 9,
      "title": "Hubの明るさ（1–20）",
      "type": "timeseries",
      "description": "Hub固有の1–20段階の明るさです。",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
